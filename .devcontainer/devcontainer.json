{
  "name": "数据库原理及应用 · 实验课",
  "image": "gvenzl/oracle-free:23-slim",

  "//": "不要覆盖镜像 CMD，否则 Oracle 不会启动",
  "overrideCommand": false,

  "//node": "这个 Oracle 镜像不含 Node.js，判题器必须靠 feature 装进来",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "containerEnv": {
    "ORACLE_PASSWORD": "oracle",
    "APP_USER": "COURSE",
    "APP_USER_PASSWORD": "course",
    "CODEROAD_TUTORIAL_URL": "https://raw.githubusercontent.com/tovuse/database-lab/main/tutorial.json",
    "NLS_LANG": "AMERICAN_AMERICA.AL32UTF8"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "CodeRoad.coderoad",
        "Oracle.oracledevtools"
      ],
      "settings": {
        "workbench.startupEditor": "none",
        "terminal.integrated.defaultLocation": "view",
        "files.encoding": "utf8",
        "files.eol": "\n",

        "//trust": "关掉工作区信任弹窗，学生打开即可用，不用点「信任文件夹并继续」",
        "security.workspace.trust.enabled": false,

        "//coderoad": "CodeRoad 面板一打开就展开，配合下面的自动启动命令",
        "coderoad.runTestsOnSave": true
      }
    }
  },

  "forwardPorts": [1521],

  "postCreateCommand": "bash scripts/postCreate.sh",
  "postStartCommand": "bash scripts/waitForDb.sh"
}
